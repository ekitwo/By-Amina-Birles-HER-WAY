# Supabase (Postgres + Auth)
# Create a project at https://supabase.com and paste its keys here.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Claude API (Anthropic) — powers Vision/Goal/Priority/Conflict/Strategy engines
ANTHROPIC_API_KEY=

# Set to "true" to run the app entirely on the in-memory mock repository
# instead of Supabase — useful for local UI work before a Supabase project
# is wired up. See src/lib/data/repository.ts.
NEXT_PUBLIC_USE_MOCK_DATA=true
